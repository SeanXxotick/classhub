# Copy to .env.local and fill in from: firebase apps:sdkconfig WEB <app id>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=classhub-975eb
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push public key (Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Files Worker address (Contents uploads); the live address is only in .env.production
VITE_FILES_URL=
