# Used by "npm run dev:emu": the app talks to the local Auth and Firestore emulators only.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-classhub
VITE_FIREBASE_AUTH_DOMAIN=demo-classhub.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app

# Local files Worker (cd files && npx wrangler dev --env dev --port 8787 --ip 127.0.0.1)
VITE_FILES_URL=http://127.0.0.1:8787
